NODE_ENV=development
PORT=3000
HOST=0.0.0.0

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
MAIL_FROM=no-reply@example.com
# Unset: no real mail outside production (jsonTransport reports success without
# sending). Set to false to send real mail from a dev machine.
MAIL_USE_TEST_TRANSPORT=

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SIGNUP_PENDING_TTL_SECONDS=900

SOCKET_CORS_ORIGIN=*

LOG_LEVEL=debug
LOG_FORMAT=pretty

ENABLE_RATE_LIMIT=false
RATE_LIMIT_MAX_PER_SECOND=10

DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://<user>:<password>@localhost:5432/star_dev
SHADOW_DATABASE_URL=postgres://<user>:<password>@localhost:5432/star_shadow