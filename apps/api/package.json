{
  "name": "@star/api",
  "module": "src/server/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "check:system": "bash system-checks/check-service.sh ${SYSTEM_UNITS:-valkey}",
    "predev": "bun run check:system",
    "dev": "bun --env-file=../../.env --watch src/server/server.ts",
    "prestart": "bun run check:system",
    "start": "bun --env-file=../../.env src/server/server.ts",
    "test": "NODE_ENV=test bun --env-file=../../.env --bun node_modules/.bin/playwright test",
    "lint": "tsc --noEmit",
    "postinstall": "bun --env-file=../../.env node_modules/.bin/prisma generate",
    "db:generate": "bun --env-file=../../.env node_modules/.bin/prisma generate",
    "db:migrate": "bun --env-file=../../.env node_modules/.bin/prisma migrate dev",
    "ws:tail": "bun run ws-tail.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@star/browser-ensemble": "workspace:*",
    "elysia": "^1.4.29",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "exports": {
    ".": "./src/server/server.ts",
    "./webSocket": "./src/socket/index.ts",
    "./email": "./src/modules/auth/providers/email",
    "./otp": "./src/modules/auth/providers/OTP"
  }
}
