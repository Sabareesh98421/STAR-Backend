# The monorepo's only .env. Bun loads it for every process started from the
# root scripts, and `--env-file=../../.env` for the API's own scripts.
#
# Generic names are namespaced on purpose. One file now feeds two servers, and
# `PORT`/`HOST` are not ours alone — Nuxt reads both, so `PORT=10108` made the
# WEB dev server bind the API's port and `HOST=0.0.0.0` put it on every
# interface. Nothing in our code read HOST at all, so it is gone rather than
# renamed.
NODE_ENV=development
# The API's port, and the web dev server's. Both processes read both: the web
# app proxies /api to API_PORT, and the API allows WEB_PORT through the
# WebSocket origin check (browsers do not apply CORS to a WS upgrade).
API_PORT=3000
WEB_PORT=3001

# Only for a SPLIT deployment, where the web app is served from somewhere the
# API is not. Left unset the app uses relative URLs, which is what makes the
# dev proxy and the one-server production build work without knowing a host.
# NUXT_PUBLIC_API_BASE=https://api.example.com/api
# NUXT_PUBLIC_WS_BASE=wss://api.example.com/api/ws
# Browser origins allowed to open the chat socket, comma-separated. REQUIRED
# once this is served on a real hostname, even as one server: same-origin is
# trusted without it only on loopback, because an attacker can point their own
# domain at your address and the request would otherwise vouch for itself.
# Defaults to http://localhost:${WEB_PORT}, which covers local work only.
# WEB_ORIGINS=https://app.example.com

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
MAIL_FROM=no-reply@example.com
# Unset: no real mail outside production (jsonTransport reports success without
# sending). Set to false to send real mail from a dev machine.
MAIL_USE_TEST_TRANSPORT=

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SIGNUP_PENDING_TTL_SECONDS=900

SOCKET_CORS_ORIGIN=*

LOG_LEVEL=debug
LOG_FORMAT=pretty

ENABLE_RATE_LIMIT=false
RATE_LIMIT_MAX_PER_SECOND=10

DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://<user>:<password>@localhost:5432/star_dev
SHADOW_DATABASE_URL=postgres://<user>:<password>@localhost:5432/star_shadow
PASSWORD_HASH_COST=10
